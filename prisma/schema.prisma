datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Codigo {
  id        String   @id @default(cuid())
  codigo    String   @unique
  cliente   String?  
  status    Boolean  @default(false) 
  createdAt DateTime @default(now())
}